FROM node:20-slim AS build

WORKDIR /app

COPY data_inspection/package.json data_inspection/package-lock.json ./
RUN npm ci

COPY data_inspection ./
RUN npm run build

FROM nginx:1.27-alpine AS runtime

COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 4173

CMD ["nginx", "-g", "daemon off;"]
